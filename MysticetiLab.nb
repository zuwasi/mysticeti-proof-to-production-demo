Notebook[{

Cell[CellGroupData[{
Cell["Mysticeti Consensus Digital Twin", "Title",ExpressionUUID->"69edb86f-b74e-0445-8e3f-59838ad39866"],

Cell["Corrected, auditable educational direct-decision model", "Subtitle",ExpressionUUID->"42c8a6cf-d338-0644-aba3-c16142d4b9d9"],

Cell["\<\
SeedRandom[42]; Get[FileNameJoin[{NotebookDirectory[], \"src\", \
\"MysticetiModel.wl\"}]]\
\>", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"acddefff-7498-5344-bb95-91e0c17687b3"],

Cell[CellGroupData[{

Cell["1. Scope and claim status", "Section",ExpressionUUID->"27703f7d-b4a4-3d42-b3ef-b213ead63a5c"],

Cell["\<\
EXACT means elementary equal-authority quorum arithmetic. FIXTURE means \
executable educational consistency evidence. CSV TRANSCRIPTION means \
consistency with the local paper transcription, not independent paper \
verification. SYNTHETIC means an uncalibrated sensitivity model. This is not \
the Sui implementation, a WAN simulation, a production prediction, or a \
complete protocol proof.\
\>", "Text",ExpressionUUID->"fe581587-d6eb-764b-a2f2-79143fca8437"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Slots, support, and authority counting", "Section",ExpressionUUID->"146f4264-368f-a34e-9e06-f60ab0cbfd94"],

Cell["\<\
A slot is explicitly <|Validator -> v, Round -> r|>; every block in that slot \
is a proposal. SupportedProposal traverses ancestors breadth-first and sorts \
each frontier by {round, validator, ID}, selecting at most one proposal. \
Every threshold counts distinct validator authorities, so equivocations never \
add quorum weight.\
\>", "Text",ExpressionUUID->"bd1056f9-1101-6944-a09d-9d11abf7c795"],

Cell[CellGroupData[{

Cell["\<\
Grid[Prepend[Table[{f, CommitteeSize[f], QuorumThreshold[f], \
HonestIntersectionLowerBound[CommitteeSize[f], QuorumThreshold[f], f]}, {f, \
1, 5}], {\"f\", \"n=3f+1\", \"q=2f+1\", \"honest intersection\"}], Frame -> \
All]\
\>", "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"a5e86d7b-31da-8c45-aaf5-f759d88ddfa4"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"f\"\>", "\<\"n=3f+1\"\>", "\<\"q=2f+1\"\>", "\<\"honest \
intersection\"\>"},
    {"1", "4", "3", "1"},
    {"2", "7", "5", "1"},
    {"3", "10", "7", "1"},
    {"4", "13", "9", "1"},
    {"5", "16", "11", "1"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.9946574478028793`*^9, 3.994657781102518*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"29cedb7e-0f0c-d144-bc26-19310603de5d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Deterministic round DAG", "Section",ExpressionUUID->"fc313236-514c-0e44-bc1b-893ae9e47369"],

Cell[CellGroupData[{

Cell["\<\
SeedRandom[42]; demoDAG = GenerateMysticetiDAG[<|\"F\" -> 2, \"Rounds\" -> 7, \
\"Seed\" -> 42, \"ByzantineCount\" -> 1, \"Equivocation\" -> True|>]; \
DAGVisualization[demoDAG]\
\>", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"a5d0c248-4f48-c54e-b3ae-485c5504b308"],

