Cell[CellGroupData[{

Cell["7. Uncalibrated synthetic timing sensitivity", "Section",ExpressionUUID->"a5cf900e-1dd7-6e43-ac1d-c614778faa5c"],

Cell[CellGroupData[{

Cell["\<\
SeedRandom[42]; sim = SimulateMysticeti[<|\"F\" -> 3, \"Rounds\" -> 9, \"Seed\
\" -> 42, \"BaseDelayMS\" -> 120., \"JitterMS\" -> 40., \"CrashCount\" -> 1, \
\"SyntheticSamples\" -> 500|>]; KeyTake[sim, {\"SyntheticSamples\", \
\"P50Milliseconds\", \"P95Milliseconds\", \"InvariantChecks\", \
\"ScientificLabel\", \"TimingAssumptions\"}]\
\>", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"8b9cad65-c9e8-f54c-8f8c-bf3ad2bcb894"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SyntheticSamples\"\>", "\[Rule]", "500"}], ",", 
   RowBox[{"\<\"P50Milliseconds\"\>", "\[Rule]", "405"}], ",", 
   RowBox[{"\<\"P95Milliseconds\"\>", "\[Rule]", "520"}], ",", 
   RowBox[{"\<\"InvariantChecks\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"ParentReferencesExist\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"DistinctParentAuthorities\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"HonestDistinctParentAuthorities\"\>", "\[Rule]", 
       "True"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"ScientificLabel\"\>", 
    "\[Rule]", "\<\"uncalibrated synthetic sensitivity model\"\>"}], ",", 
   RowBox[{"\<\"TimingAssumptions\"\>", 
    "\[Rule]", "\<\"500 seeded samples by default; latency=max(1,3*base delay \
+ sum of three Gaussian message-delay perturbations + 45 ms/crash + 25 \
ms/Byzantine). Not a WAN simulation or production prediction.\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9946574483565083`*^9, 3.9946577815471*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"6a95a95b-365a-cc4a-9eb3-f6b70ce06421"]
}, Open  ]],

Cell["\<\
The formula is max(1, 3 base delays + three independent Gaussian \
perturbations + 45 ms per crash + 25 ms per Byzantine authority), using at \
least 250 seeded samples. Three message delays represent the proposal, \
supporter, and certificate/decision progression. Parameters are uncalibrated; \
outputs are neither WAN simulation nor production prediction.\
\>", "Text",ExpressionUUID->"dc0cd30a-2a48-8b4d-894f-eea311f87814"]
}, Open  ]],

